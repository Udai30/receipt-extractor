# Copy to .env and fill in. Never commit .env. Values here are placeholders only.

# --- Docker Compose database (read by docker-compose.yml, not by the app) -------
# No default password exists anywhere: compose refuses to start until it is set.
# Prefer URL-safe characters only (letters, digits, - _ .). If the password contains others
# (@ : / # % ? space ...), percent-encode it in DATABASE_URL (e.g. @ -> %40) and keep it
# plain here.
POSTGRES_USER=receipts
POSTGRES_PASSWORD=
POSTGRES_DB=receipts
# Host port, bound to 127.0.0.1 only
POSTGRES_PORT=5432
# Host port for the api service, bound to 127.0.0.1 only
API_PORT=8000

# --- Required ------------------------------------------------------------------
# Async SQLAlchemy URL (driver must be postgresql+asyncpg). For the compose database use
# the same user/password/db/port as above. The api container overrides the host to `db`.
DATABASE_URL=postgresql+asyncpg://receipts:CHANGE_ME@127.0.0.1:5432/receipts

# --- Connection pool (per process) --------------------------------------------
# Persistent connections kept open (1-50)
DB_POOL_SIZE=5
# Extra connections allowed under bursts (0-50)
DB_MAX_OVERFLOW=5
# Seconds to wait for a free connection before failing (0-120)
DB_POOL_TIMEOUT_S=10

# --- Provider credentials (free tiers only; see configs/models.yaml) -----------
# Groq free plan: https://console.groq.com/keys
GROQ_API_KEY=
# Gemini API free tier: https://aistudio.google.com/apikey
# Free-tier data may be used by Google: only public CORD images are ever sent.
GEMINI_API_KEY=
# Hugging Face read token (optional; raises dataset/model download rate limits)
HF_TOKEN=

# --- Local services ------------------------------------------------------------
# From inside Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# --- Runtime -------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# true on the public demo: smaller limits, cache-only fallback when budgets run out
DEMO_MODE=false
