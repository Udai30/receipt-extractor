{
  "permissions": {
    "deny": [
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git config *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git branch *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git config *)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git reset *)",
      "PowerShell(git rebase *)",
      "PowerShell(git merge *)",
      "PowerShell(git branch *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/git_guard.py\"",
            "shell": "bash",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "Checking git guard"
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Udai/.local/bin/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Udai/.local/bin/graphify.EXE hook-guard read"
          }
        ]
      }
    ]
  }
}