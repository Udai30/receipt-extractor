# Copy to .env and fill in. Never commit .env. Values here are placeholders only.

# --- Provider credentials (free tiers only; see configs/models.yaml) -----------
# Groq free plan: https://console.groq.com/keys
GROQ_API_KEY=
# Gemini API free tier: https://aistudio.google.com/apikey
# Free-tier data may be used by Google: only public CORD images are ever sent.
GEMINI_API_KEY=
# Hugging Face read token (optional; raises dataset/model download rate limits)
HF_TOKEN=

# --- LLM provider layer (TRD §S3) ----------------------------------------------
# Model registry (aliases, limits) and dated list prices
LLM_MODELS_PATH=configs/models.yaml
LLM_PRICING_PATH=configs/pricing.yaml
# Disk cache of model responses (on for eval runs, off for live demo traffic)
LLM_CACHE_DIR=.cache/llm
# Today's request/token usage per alias (UTC day), so sweeps pause before free-tier limits
LLM_BUDGET_PATH=.cache/llm_budget.json
# Concurrent provider calls per process (1-64)
LLM_MAX_CONCURRENCY=4
# Hard timeout per provider call, seconds (0-600)
LLM_TIMEOUT_S=60

# --- Local services ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# --- Runtime -------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# true on the public demo: smaller limits, cache-only fallback when budgets run out
DEMO_MODE=false
# live upload extractions per UTC day when DEMO_MODE=true (samples are always served from cache)
DEMO_DAILY_REQUESTS=100
